# Root gitignore for CleanSight (AI Garbage Detector & Collector)

# Dependencies
node_modules/
*/node_modules/

# Production build artifacts
dist/
*/dist/
build/
*/build/

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
*.env
!.env.example
!*/.env.example
*.local

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
cleansight.db
backend/cleansight.db

# Uploaded user files
backend/uploads/*
!backend/uploads/.gitkeep

# System & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
